    {
      "name": "Games - CRUD",
      "item": [
        {
          "name": "POST /api/games - Create game",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Game\",\n  \"description\": \"Juego creado automáticamente desde Postman\",\n  \"category\": \"estrategia\",\n  \"minPlayers\": 2,\n  \"maxPlayers\": 4,\n  \"minAge\": 10,\n  \"stock\": 5,\n  \"tags\": [\n    \"postman\",\n    \"test\",\n    \"estrategia\"\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/games"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "const game = pm.response.json();",
                  "pm.test('Created game has an id', function () { pm.expect(game.id).to.be.a('number'); });",
                  "pm.test('Created game has expected name', function () { pm.expect(game.name).to.eql('Postman Test Game'); });",
                  "pm.collectionVariables.set('gameId', game.id);"
                ]
              }
            }
          ]
        },
